# Copy this file to .env and fill in your values.
# .env is already in .gitignore -- never commit real secrets.
#
# Argus reads configuration from the environment or from a .env file in the
# working directory (see argus/config.py). Everything below is optional
# except the three required keys.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Claude Agent SDK reviewer sessions and the planner/coverage/writer calls.
ANTHROPIC_API_KEY=

# Read-only GitHub PAT for fetching the PR diff and cloning the repo into the
# review worktree. Needs "Contents: read" + "Pull requests: read" on a
# fine-grained PAT, or "repo" read on a classic one.
GITHUB_TOKEN_RO=

# Structured extraction of the final review (plan-extraction fallback path).
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Optional: shared Postgres storage (round history + pipeline checkpoints)
# ---------------------------------------------------------------------------
# Leave unset to use the local SQLite default (~/.local/share/argus/history.db)
# -- fine for solo use. Set this to share history across a team or CI; see
# docs/STORAGE.md for the schema/*.sql files to apply first.
#
# ARGUS_DB_URL=postgresql://user:pass@host:5432/dbname
#
# SUPABASE_DB_URL is accepted as an alias for ARGUS_DB_URL, so a Supabase
# connection string (e.g. from a project's pooler connection settings) works
# as-is:
# SUPABASE_DB_URL=postgresql://user:pass@host:6543/postgres

# ---------------------------------------------------------------------------
# Optional: HTTP storage backend (for sandboxes that can't reach Postgres
# directly, e.g. egress restricted to port 443)
# ---------------------------------------------------------------------------
# See docs/STORAGE.md for the two-endpoint contract if you're implementing
# your own backend service.
#
# ARGUS_STORAGE_READ_URL=
# ARGUS_STORAGE_WRITE_URL=
# ARGUS_STORAGE_AUTH=

# ---------------------------------------------------------------------------
# Optional: prompt customization
# ---------------------------------------------------------------------------
# Directory of prompt overrides -- see docs/CUSTOMIZING_PROMPTS.md. This is
# the highest-priority override; ./.argus/prompts/ and
# ~/.config/argus/prompts/ are also checked automatically with no env var
# needed.
# ARGUS_PROMPTS_DIR=./my-prompts

# Set to skip every prompt override directory (including ARGUS_PROMPTS_DIR
# above) and force the packaged prompts only. For CI/official runs that
# must not pick up a developer's local override by accident.
# ARGUS_NO_PROMPT_OVERRIDES=1

# ---------------------------------------------------------------------------
# Optional: misc
# ---------------------------------------------------------------------------
# Pin the LangGraph SQLite checkpoint file (default: a per-run temp file).
# ARGUS_SQLITE_CHECKPOINT_PATH=

# Override the per-session context-usage ledger path (default: a per-pid
# temp file under /tmp, auto-removed on subprocess exit unless this is set).
# ARGUS_CONTEXT_LEDGER_PATH=

# Override the local SQLite round-history file location.
# ARGUS_HISTORY_DB_PATH=

# Mirror-clone cache directory.
# ARGUS_REPO_CACHE=

# LangSmith tracing for reviewer sessions.
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=
# Pass-through LangSmith SDK variable (not Argus-declared) -- only needed if
# you're proxying the LangSmith endpoint itself, e.g. through your own
# credential-vending layer. See "Tracing reviewer sessions" in the README.
# LANGSMITH_ENDPOINT=

# Context7 docs MCP (used by some specialist prompts to verify current
# framework APIs).
# CONTEXT7_API_KEY=
# ARGUS_CONTEXT7_LIBRARY_ID=
# Override Context7's MCP endpoint URL (default: https://mcp.context7.com/mcp).
# Needed by callers that proxy CONTEXT7_API_KEY through an intermediary rather
# than passing the real key directly (e.g. the argus-review-loop skill's rh-mcp
# credential proxy, TECH-4736).
# ARGUS_CONTEXT7_BASE_URL=

# Wall-clock seconds a reviewer subprocess is allowed to run before it's
# killed and reported as TIMED_OUT. Default: 420.
# ARGUS_SESSION_TIMEOUT=420
