{
  "$defs": {
    "DroppedFinding": {
      "description": "A BLOCKING finding that was rejected by the post-writer validator.",
      "properties": {
        "finding": {
          "$ref": "#/$defs/Finding"
        },
        "rejection_rationale": {
          "description": "Evidence-based explanation of why this finding was rejected",
          "title": "Rejection Rationale",
          "type": "string"
        }
      },
      "required": [
        "finding",
        "rejection_rationale"
      ],
      "title": "DroppedFinding",
      "type": "object"
    },
    "Finding": {
      "description": "A single review finding.",
      "properties": {
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "category": {
          "description": "Review category: code-correctness, security, cross-layer, test-adequacy, cross-cutting, deterministic-precheck (a candidate-rule hit from a deterministic scanner such as semgrep/zizmor), coverage-gap (a reviewer session or scanner that timed out or crashed, synthesized by helpers.build_degraded_coverage_findings -- not a real code-quality finding), argus-self-config (a modification to Argus's own reviewer bench configuration)",
          "title": "Category",
          "type": "string"
        },
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "File path, if applicable",
          "title": "File"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Line number, if applicable",
          "title": "Line"
        },
        "description": {
          "description": "Human-readable description of the finding",
          "title": "Description",
          "type": "string"
        },
        "suggestion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Suggested fix or improvement",
          "title": "Suggestion"
        }
      },
      "required": [
        "severity",
        "category",
        "description"
      ],
      "title": "Finding",
      "type": "object"
    },
    "PriorFeedbackItem": {
      "description": "Status of a prior-round finding after verification.",
      "properties": {
        "severity": {
          "description": "Original severity: BLOCKING or SUGGESTION",
          "title": "Severity",
          "type": "string"
        },
        "description": {
          "description": "Original finding description",
          "title": "Description",
          "type": "string"
        },
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File"
        },
        "status": {
          "description": "RESOLVED, UNRESOLVED, or REGRESSED",
          "title": "Status",
          "type": "string"
        },
        "rationale": {
          "default": "",
          "description": "Why this status was assigned",
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "severity",
        "description",
        "status"
      ],
      "title": "PriorFeedbackItem",
      "type": "object"
    },
    "ReviewHalt": {
      "description": "Pipeline-generated stop: the review ended before a normal verdict (always BLOCKING).",
      "properties": {
        "code": {
          "enum": [
            "scope_split",
            "scope_unverified",
            "dispatch_budget_exceeded",
            "gap_fill_cap_exceeded"
          ],
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "head_sha": {
          "title": "Head Sha",
          "type": "string"
        },
        "split_suggestions": {
          "items": {
            "$ref": "#/$defs/ScopeBehavior"
          },
          "title": "Split Suggestions",
          "type": "array"
        },
        "dispatch_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dispatch Count"
        },
        "dispatch_budget": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dispatch Budget"
        }
      },
      "required": [
        "code",
        "detail",
        "head_sha"
      ],
      "title": "ReviewHalt",
      "type": "object"
    },
    "RiskLevel": {
      "description": "Risk classification for the PR.",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "title": "RiskLevel",
      "type": "string"
    },
    "ScopeBehavior": {
      "description": "One independently mergeable behavior within a PR.",
      "properties": {
        "title": {
          "description": "Unique behavior title within the receipt",
          "title": "Title",
          "type": "string"
        },
        "files": {
          "items": {
            "type": "string"
          },
          "title": "Files",
          "type": "array"
        },
        "depends_on": {
          "description": "Titles of behaviors this one depends on",
          "items": {
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        }
      },
      "required": [
        "title"
      ],
      "title": "ScopeBehavior",
      "type": "object"
    },
    "ScopeReceipt": {
      "description": "Pipeline-generated proof that the full PR was scope-checked at a pinned head.",
      "properties": {
        "base_sha": {
          "title": "Base Sha",
          "type": "string"
        },
        "head_sha": {
          "title": "Head Sha",
          "type": "string"
        },
        "behaviors": {
          "items": {
            "$ref": "#/$defs/ScopeBehavior"
          },
          "title": "Behaviors",
          "type": "array"
        },
        "rationale": {
          "default": "",
          "title": "Rationale",
          "type": "string"
        },
        "override_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Human override reason when the gate was explicitly overridden",
          "title": "Override Reason"
        }
      },
      "required": [
        "base_sha",
        "head_sha"
      ],
      "title": "ScopeReceipt",
      "type": "object"
    },
    "Severity": {
      "description": "Finding severity \u2014 only two levels by design.\n\nBLOCKING = runtime failures and security vulnerabilities only.\nSUGGESTION = everything else.",
      "enum": [
        "BLOCKING",
        "SUGGESTION"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SystemCoverage": {
      "description": "Coverage status for a reviewed system group.",
      "properties": {
        "system": {
          "description": "System group name, e.g. 'Review service orchestrator'",
          "title": "System",
          "type": "string"
        },
        "files_explored": {
          "description": "Files the subagent read",
          "items": {
            "type": "string"
          },
          "title": "Files Explored",
          "type": "array"
        },
        "checks_performed": {
          "description": "What conventions/patterns were checked",
          "items": {
            "type": "string"
          },
          "title": "Checks Performed",
          "type": "array"
        }
      },
      "required": [
        "system"
      ],
      "title": "SystemCoverage",
      "type": "object"
    },
    "TokenUsage": {
      "description": "Aggregated token usage across orchestrator + all subagents.",
      "properties": {
        "input_tokens": {
          "default": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "cache_read_tokens": {
          "default": 0,
          "title": "Cache Read Tokens",
          "type": "integer"
        },
        "cache_creation_tokens": {
          "default": 0,
          "title": "Cache Creation Tokens",
          "type": "integer"
        },
        "cost_usd": {
          "default": 0.0,
          "description": "Estimated total cost in USD",
          "title": "Cost Usd",
          "type": "number"
        }
      },
      "title": "TokenUsage",
      "type": "object"
    },
    "Verdict": {
      "description": "Overall review verdict.",
      "enum": [
        "APPROVE",
        "BLOCKING"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "description": "POST /review response body.",
  "properties": {
    "verdict": {
      "$ref": "#/$defs/Verdict"
    },
    "risk_level": {
      "$ref": "#/$defs/RiskLevel"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "dropped_findings": {
      "description": "BLOCKING findings rejected by the validator (audit trail, not shown in comment)",
      "items": {
        "$ref": "#/$defs/DroppedFinding"
      },
      "title": "Dropped Findings",
      "type": "array"
    },
    "prior_feedback": {
      "description": "Verification status of prior-round findings (empty for round 1)",
      "items": {
        "$ref": "#/$defs/PriorFeedbackItem"
      },
      "title": "Prior Feedback",
      "type": "array"
    },
    "coverage_map": {
      "items": {
        "$ref": "#/$defs/SystemCoverage"
      },
      "title": "Coverage Map",
      "type": "array"
    },
    "notes_for_next_round": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Structured notes for the next review round (coverage map + findings with status)",
      "title": "Notes For Next Round"
    },
    "review_comment": {
      "description": "Formatted markdown comment ready to post on the PR",
      "title": "Review Comment",
      "type": "string"
    },
    "review_round": {
      "default": 1,
      "description": "Which review round this is (1 = first review, 2+ = incremental)",
      "title": "Review Round",
      "type": "integer"
    },
    "prior_review_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "UUID of the prior review this round builds on (None for round 1)",
      "title": "Prior Review Id"
    },
    "usage": {
      "$ref": "#/$defs/TokenUsage"
    },
    "lite_mode": {
      "default": false,
      "description": "True if this review was performed in lite mode (single-pass check)",
      "title": "Lite Mode",
      "type": "boolean"
    },
    "preflight_reason": {
      "default": "",
      "description": "Preflight routing reason \u2014 stored in result_json for lite round history",
      "title": "Preflight Reason",
      "type": "string"
    },
    "stage_costs": {
      "additionalProperties": {
        "type": "number"
      },
      "description": "Per-stage USD cost for this round (planner, writer, reviewer:<label>, ...)",
      "title": "Stage Costs",
      "type": "object"
    },
    "stage_seconds": {
      "additionalProperties": {
        "type": "number"
      },
      "description": "Per-stage wall-clock seconds for this round, keyed like stage_costs",
      "title": "Stage Seconds",
      "type": "object"
    },
    "scope": {
      "anyOf": [
        {
          "$ref": "#/$defs/ScopeReceipt"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Scope receipt set by the pipeline; never LLM-generated"
    },
    "halt": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReviewHalt"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Set when the pipeline halted before a normal verdict; never LLM-generated"
    }
  },
  "required": [
    "verdict",
    "risk_level",
    "review_comment"
  ],
  "title": "ReviewResponse",
  "type": "object"
}
